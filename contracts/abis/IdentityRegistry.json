{
  "abi": [
    {
      "type": "function",
      "name": "register",
      "stateMutability": "nonpayable",
      "inputs": [{ "name": "metadataURI", "type": "string" }],
      "outputs": []
    },
    {
      "type": "function",
      "name": "getAgent",
      "stateMutability": "view",
      "inputs": [{ "name": "agentId", "type": "uint256" }],
      "outputs": [
